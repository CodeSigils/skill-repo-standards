#!/bin/sh
# Run the full deterministic suite before a push leaves the machine.
set -eu

run() {
    label="$1"
    shift
    printf '=== pre-push: %s ===\n' "$label"
    "$@"
}

run "commit message checks" python3 scripts/check_commit_messages.py --self-test
run "standards check self-test" python3 scripts/standards_check.py --self-test
run "standards check" python3 scripts/standards_check.py
run "conformance corpus self-test" python3 scripts/check_conformance.py --self-test
run "conformance corpus" python3 scripts/check_conformance.py
run "gate checker self-test" python3 scripts/gate_check.py --self-test
run "URL verifier self-test" python3 scripts/verify_urls.py --self-test
